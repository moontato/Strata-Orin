From 96745615ae3a0683ceb49275770bb9861eaed936 Mon Sep 17 00:00:00 2001
From: Strata Orin Port <orin-port@example.invalid>
Date: Thu, 22 Oct 2026 07:19:14 +0000
Subject: [PATCH 2/4] platform: order ARM mapped-memory doorbells with system
 barriers

Retain x86 pause and sfence instructions. Add ARM yield and dmb sy at the fork publication/consumption sites, adapted to the current verifier. This is a candidate ordering fix, not proof of Orin runtime correctness; run the mapped handshake test on hardware.
---
 include/strata/platform/mapped_memory.hpp | 32 ++++++++++++++
 src/core/graph.cpp                        |  4 +-
 src/core/mtp.cpp                          | 19 ++++-----
 src/core/session.cpp                      | 15 +++----
 src/core/verify.cpp                       | 51 +++++++++++++++--------
 5 files changed, 81 insertions(+), 40 deletions(-)
 create mode 100644 include/strata/platform/mapped_memory.hpp

diff --git a/include/strata/platform/mapped_memory.hpp b/include/strata/platform/mapped_memory.hpp
new file mode 100644
index 00000000..47cb1757
--- /dev/null
+++ b/include/strata/platform/mapped_memory.hpp
@@ -0,0 +1,32 @@
+#pragma once
+#include <atomic>
+#include "strata/platform/cpu_arch.hpp"
+#if STRATA_CPU_X86
+#include <immintrin.h>
+#endif
+
+namespace strata::platform {
+// CPU side of CUDA's mapped-host doorbell protocol. The GPU publishes with
+// __threadfence_system(). ARM needs an explicit system barrier before consuming
+// payloads and before notifying the GPU; volatile polling alone is insufficient.
+inline void mapped_memory_acquire() noexcept {
+#if defined(__aarch64__) || defined(__arm__)
+    __asm__ __volatile__("dmb sy" ::: "memory");
+#endif
+}
+inline void mapped_memory_release() noexcept {
+#if defined(__aarch64__) || defined(__arm__)
+    __asm__ __volatile__("dmb sy" ::: "memory");
+#elif STRATA_CPU_X86
+    _mm_sfence();  // Includes write-combined mapped stores.
+#else
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+#endif
+}
+// Newly added publication sites must not change the existing x86 path.
+inline void mapped_memory_arm_release() noexcept {
+#if defined(__aarch64__) || defined(__arm__)
+    mapped_memory_release();
+#endif
+}
+}  // namespace strata::platform
